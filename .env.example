# Wajib di Railway
MONGO_URL=mongodb://...            # dari plugin MongoDB Railway atau MongoDB Atlas
DB_NAME=service_desk
USE_MOCK_DB=false                  # true hanya untuk coba-coba: data hilang saat restart
SECRET_KEY=ganti-dengan-string-acak-panjang
DEFAULT_ADMIN_PIN=123456           # WAJIB 6 digit angka. PIN user "Admin" sampai Admin pertama kali login
# RESET_ADMIN_PIN=true             # darurat: reset PIN Admin ke DEFAULT_ADMIN_PIN saat start. Hapus setelah login.
METRICS_API_KEY=ganti-api-key      # untuk GET /api/public-metrics/service
PUBLIC_BASE_URL=https://servicedesk.crkgroup.app   # dipakai di email (notifikasi, verifikasi, akun aktif)
TZ=Asia/Jakarta
ALLOWED_EMAIL_DOMAIN=citarasakuliner.com   # hanya email domain ini yang boleh mendaftar & dipakai user
DATA_DIR=/data                     # pasang Railway Volume di /data (foto bukti + backup)

# Email alert & rekap (pilih salah satu, opsional)
RESEND_API_KEY=
MAIL_FROM=Service Desk <cs@domainanda.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
